# Azure OpenAI Configuration
# ======================
# Required: Your Azure OpenAI service credentials
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Model-specific Configurations
# ===========================
# Required: API versions and deployment names for different models
AZURE_OPENAI_API_VERSION_MINI=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_MINI=your-mini-model-deployment-name
AZURE_OPENAI_API_VERSION_NANO=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NANO=your-nano-model-deployment-name

# Application Settings
# ==================
# Optional: Debug and other application settings
DEBUG=False

# Note: 
# 1. Copy this file to .env and replace the placeholder values with your actual credentials
# 2. Do not commit the .env file to version control
# 3. Keep your API keys and credentials secure
